#include <stdio.h> 
int main() 
{ 
int n, i, j, a; 
printf("Enter the number of elements: "); 
scanf("%d", &n); 
int arr[n]; 
printf("Enter the elements:"); 
for(i = 0; i < n; i++) 
{ 
scanf("%d", &arr[i]); 
} 
for(i = 0; i < n - 1; i++) 
{ 
for(j = 0; j < n - i - 1; j++) 
{ 
if(arr[j] > arr[j + 1]) 
{ 
a = arr[j]; 
arr[j] = arr[j + 1]; 
arr[j + 1] = a; 
} 
} 
} 
printf("\nSorted Array: "); 
for(i = 0; i < n; i++) 
{ 
printf("%d ", arr[i]); 
}
printf("\nMinimum = %d", arr[0]); 
printf("\nMaximum = %d", arr[n - 1]); printf("\nMiddle = %d", arr[n / 2]); 
return 0; 
} 
